<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
    "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.buddiesofbudgie.KeyboardLayout">
    <!--
      Session bus dbus interface via budgie-daemon. This
      applet call SetKeyboardLayout to request a change of the active XKB
      keyboard layout.
      Note we don't use org.freedesktop.locale1's SetX11Keyboard
      since some distro's blocks this method with a permission denied error.
    -->
    <method name="SetKeyboardLayout">
      <arg type="s" name="layout" direction="in" />
    </method>
    <signal name="LayoutChanged">
      <arg type="s" name="layout" />
    </signal>
    <!--
      The layout in use, e.g. "fi". Written by the compositor bridge once it
      has applied a layout change, since neither the applet nor the daemon can
      tell which of the configured layouts is active.
    -->
    <property name="CurrentLayout" type="s" access="readwrite" />
  </interface>
</node>
