<labwc_config version="3">
	<desktops number="2">
		<popupTime>1000</popupTime>
	</desktops>
	<keyboard>
		<numlock>off</numlock>

		<!-- bridged keybinds merged from keybinds.xml(.example) and current
		     gsettings bridged keys.
		-->

		<keybind key="XF86AudioNext">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Next" />
		</keybind>
		<keybind key="XF86AudioPause">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Pause" />
		</keybind>
		<keybind key="XF86AudioPlay">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.PlayPause" />
		</keybind>
		<keybind key="XF86AudioPrev">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Previous" />
		</keybind>
		<keybind key="XF86AudioStop">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Stop" />
		</keybind>

	</keyboard>
	<theme>
		<name>Pocillo-dark</name>
		<dropShadows>yes</dropShadows>
		<font place="ActiveWindow" name="Noto Sans" weight="Bold" size="11" slant="Normal" />
		<font place="InactiveWindow" name="Noto Sans" weight="Bold" size="11" slant="Normal" />
		<titlebar>
			<layout>:iconify,max,close:</layout>
		</titlebar>
		<icon>Pocillo</icon>
	</theme>
	<windowRules>
		<windowRule identifier="Nemo-desktop" title="Desktop" skipTaskbar="yes" skipWindowSwitcher="yes">
			<action name="ToggleAlwaysOnBottom" />
		</windowRule>
		<windowRule identifier="nemo-desktop" title="nemo-desktop" skipTaskbar="yes" skipWindowSwitcher="yes">
			<action name="ToggleAlwaysOnBottom" />
		</windowRule>
		<windowRule identifier="budgie-power-dialog" title="budgie-power-dialog" skipTaskbar="yes" skipWindowSwitcher="yes">
			<action name="AutoPlace" policy="center" />
		</windowRule>
		<windowRule identifier="budgie-daemon" title="budgie-daemon" skipTaskbar="yes" skipWindowSwitcher="yes">
			<action name="AutoPlace" policy="center" />
		</windowRule>
	</windowRules>
	<placement>
		<policy>center</policy>
	</placement>
	<focus>
		<followMouse>no</followMouse>
		<raiseOnFocus>no</raiseOnFocus>
	</focus>
	<snapping>
		<range inner="10" outer="10">10</range>
	</snapping>
	<windowSwitcher style="thumbnail" allWorkspaces="no" />
	<mouse>
		<doubleClickTime>400</doubleClickTime>
	</mouse>
	<libinput>
		<device category="touchpad">
			<naturalScroll>no</naturalScroll>
			<leftHanded>no</leftHanded>
			<pointerSpeed>0.0</pointerSpeed>
			<accelProfile>flat</accelProfile>
			<tap>yes</tap>
			<tapButtonMap>default</tapButtonMap>
			<tapAndDrag>yes</tapAndDrag>
			<dragLock>no</dragLock>
			<middleEmulation>no</middleEmulation>
			<disableWhileTyping>yes</disableWhileTyping>
			<scrollMethod>twofinger</scrollMethod>
			<clickMethod>clickfinger</clickMethod>
			<sendEventsMode>yes</sendEventsMode>
		</device>
		<device category="non-touch">
			<naturalScroll>no</naturalScroll>
			<leftHanded>no</leftHanded>
			<pointerSpeed>0.0</pointerSpeed>
			<accelProfile>adaptive</accelProfile>
			<middleEmulation>yes</middleEmulation>
		</device>
	</libinput>
</labwc_config>